# Copy to deploy/.env and replace every value. Never commit deploy/.env.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
TEST_AGENT_MYSQL_PASSWORD=replace-with-random-application-password
TEST_AGENT_ROLE_TOKENS=admin=replace-admin;operator=replace-operator;viewer=replace-viewer;worker=replace-worker
TEST_AGENT_MAVEN_REPOSITORY=C:\test-agent-cache\maven-repository
