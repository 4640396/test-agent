{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@cxmt/protocol": ["./packages/protocol/src/index.ts"],
      "@cxmt/protocol/*": ["./packages/protocol/src/*.ts"],
      "@cxmt/telemetry": ["./packages/telemetry/src/index.ts"],
      "@cxmt/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
      "@cxmt/ai": ["./packages/ai/src/index.ts"],
      "@cxmt/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
      "@cxmt/ai/dist/*": ["./packages/ai/src/*"],
      "@cxmt/agent-core": ["./packages/agent-core/src/index.ts"],
      "@cxmt/agent-core/node": ["./packages/agent-core/src/node.ts"],
      "@cxmt/agent-core/session/testing": ["./packages/agent-core/src/harness/session/testing/index.ts"],
      "@cxmt/agent-core/*": ["./packages/agent-core/src/*"],
      "@cxmt/sub": ["./packages/sub/src/index.ts"],
      "@cxmt/sub/*": ["./packages/sub/src/*"]
    }
  },
  "include": ["packages/*/src/**/*"],
  "exclude": [
    "**/dist/**",
    "node_modules",
    "packages/gui/**",
    "packages/ai/src/providers/*.models.ts",
    "packages/ai/src/models.generated.ts",
    "packages/ai/src/providers/all.ts",
    "packages/ai/src/compat.ts",
    "packages/ai/src/cli.ts",
    "packages/ai/src/bun-oauth.ts",
    "packages/ai/src/auth/oauth/github-copilot.ts"
  ]
}

