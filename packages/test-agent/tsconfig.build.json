{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"erasableSyntaxOnly": false,
		"paths": {
			"@cxmt/protocol": ["../protocol/dist/index.d.ts"],
			"@cxmt/protocol/*": ["../protocol/dist/*.d.ts"],
			"@cxmt/telemetry": ["../telemetry/dist/index.d.ts"],
			"@cxmt/ai": ["../ai/dist/index.d.ts"],
			"@cxmt/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/api/*.d.ts"],
			"@cxmt/agent-core": ["../agent-core/dist/index.d.ts"],
			"@cxmt/agent-core/node": ["../agent-core/dist/node.d.ts"],
			"@cxmt/sub": ["../sub/dist/index.d.ts"],
			"@cxmt/sub/*": ["../sub/dist/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "src/**/*.d.ts"]
}
