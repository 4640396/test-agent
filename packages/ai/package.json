{
  "name": "@cxmt/ai",
  "version": "0.84.2",
  "description": "Vendored pi-ai (MIT, Copyright (c) 2025 Mario Zechner) — unified LLM API with automatic model discovery and provider configuration",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/images.js",
    "./dist/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./bedrock-provider": {
      "types": "./dist/bedrock-provider.d.ts",
      "import": "./dist/bedrock-provider.js"
    },
    "./bun-oauth": {
      "types": "./dist/bun-oauth.d.ts",
      "import": "./dist/bun-oauth.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@cxmt/telemetry": "^0.84.2",
    "@google/genai": "1.52.0",
    "@opentelemetry/api": "1.9.0",
    "@smithy/node-http-handler": "4.7.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.7"
  }
}
