{
  "name": "cimdev-test-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Test Agent desktop QA pipeline",
  "productName": "Test Agent",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit -p packages/gui/src/renderer/tsconfig.json && tsc --noEmit -p packages/gui/src/main/tsconfig.json && tsc --noEmit -p packages/gui/src/preload/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tools/scripts/gui-e2e.mjs",
    "build:packages": "cd packages/protocol && npm run build && cd ../telemetry && npm run build && cd ../ai && npm run build && cd ../agent-core && npm run build && cd ../sub && npm run build && cd ../test-agent && npm run build",
    "clean:packages": "npm run clean --workspaces --if-present",
    "build": "npm run build:packages && npm run typecheck && electron-vite build",
    "worker": "node packages/test-agent/dist/modes/worker-mode.js",
    "host": "node out/main/host-cli.js",
    "server:build": "mvn -f services/control-server/pom.xml package",
    "readiness:static": "node tools/scripts/production-readiness.mjs",
    "readiness:capabilities": "vitest run tools/tests/production-capabilities.test.ts",
    "readiness:production": "node tools/scripts/production-readiness.mjs --production",
    "e2e:production": "node tools/scripts/production-e2e.mjs",
    "test:mysql": "node tools/scripts/mysql-integration.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@standard-schema/spec": "^1.1.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "shx": "0.3.4",
    "typescript": "5.9.3",
    "vitest": "^3.0.7"
  },
  "build": {
    "appId": "com.cxmt.test-agent",
    "productName": "Test Agent",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/main/host-cli.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/@playwright",
        "to": "node_modules/@playwright",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/playwright",
        "to": "node_modules/playwright",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/playwright-core",
        "to": "node_modules/playwright-core",
        "filter": ["**/*"]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
